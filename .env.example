# Environment Variables — NEVER commit real values to version control.
# Copy this to .env and fill in your values.

# Django
DJANGO_SECRET_KEY=your-very-secret-key-here
DEBUG=0

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=adama_reports_db
DB_USER=postgres
DB_PASSWORD=change-this-strong-password

# Firebase Cloud Messaging
# Get this from your Firebase project settings > Cloud Messaging
FIREBASE_SERVER_KEY=

# Domain (fill in when official domain is assigned)
# API_DOMAIN=api.[official-domain]
# WEB_DOMAIN=admin.[official-domain]
