# Environment Variables — NEVER commit real values to version control.
# Copy this to .env and fill in your values.

# Django
DJANGO_SECRET_KEY=your-very-secret-key-here
DEBUG=0

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=adama_reports_db
DB_USER=postgres
DB_PASSWORD=change-this-strong-password

# Firebase Cloud Messaging
# Get this from your Firebase project settings > Cloud Messaging
FIREBASE_SERVER_KEY=

# TextBee SMS Gateway (https://textbee.dev)
# 1. Create account at https://app.textbee.dev
# 2. Install TextBee app on your Android phone and connect it
# 3. Copy your API key from Dashboard > API Keys
# 4. Copy your device ID from Dashboard > Devices (the _id field)
TEXTBEE_API_KEY=your-textbee-api-key-here
TEXTBEE_DEVICE_ID=your-textbee-device-id-here

# OTP expiry in minutes (default: 10)
OTP_EXPIRY_MINUTES=10

# Domain (fill in when official domain is assigned)
# API_DOMAIN=api.[official-domain]
# WEB_DOMAIN=admin.[official-domain]
